{
  "name": "vscode-stacktape",
  "displayName": "Stacktape",
  "version": "1.0.0",
  "description": "Validation, autocomplete & more for Stacktape configuration files.",
  "categories": [
    "Linters",
    "Programming Languages"
  ],
  "keywords": [
    "autocompletion",
    "stacktape",
    "validation",
    "yaml"
  ],
  "bugs": "https://github.com/stacktape/stacktape/issues",
  "license": "MIT",
  "author": "Stacktape",
  "contributors": [],
  "repository": {
    "type": "git",
    "url": "https://github.com/stacktape/editor-extension"
  },
  "publisher": "stacktape",
  "main": "./dist/extension/index.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:dev": "node scripts/build.mjs --dev",
    "watch": "node scripts/build.mjs --dev --watch",
    "lint": "eslint \"{extension,yaml-language-server,scripts}/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "package": "pnpm build && vsce package --no-dependencies",
    "vs:publish": "pnpm build && vsce publish --no-dependencies",
    "vs:login": "vsce login stacktape"
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "jsonc-parser": "^3.3.1",
    "micromatch": "^4.0.8",
    "pluralize": "^8.0.0",
    "vscode-json-languageservice": "^4.2.1",
    "vscode-languageclient": "7.0.0",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-protocol": "^3.17.5",
    "vscode-languageserver-textdocument": "^1.0.12",
    "vscode-languageserver-types": "^3.17.5",
    "vscode-nls": "^5.2.0",
    "vscode-uri": "^3.0.8",
    "yaml-language-server-parser": "0.1.3-fa8245c.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/micromatch": "^4.0.9",
    "@types/node": "^20.14.0",
    "@types/pluralize": "^0.0.33",
    "@types/vscode": "^1.82.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.25.0",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-array-func": "^4.0.0",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jest": "^28.8.0",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-promise": "^6.6.0",
    "prettier": "^2.8.8",
    "source-map-support": "^0.5.21",
    "typescript": "^5.6.0"
  },
  "contributes": {
    "languages": [
      {
        "id": "stacktape",
        "aliases": [
          "Stacktape"
        ],
        "filenamePatterns": [
          "*stacktape.yml",
          "*stp.yml",
          "*stacktape.yaml",
          "*stp.yaml",
          "*stacktape.debug.yml",
          "*stp.debug.yml",
          "*stacktape.debug.yaml",
          "*stp.debug.yaml"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "stacktape",
        "scopeName": "source.yaml",
        "path": "./syntaxes/yaml.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Stacktape",
      "properties": {
        "stacktape.validate": {
          "type": "boolean",
          "default": true,
          "description": "Enable/disable validation of Stacktape configuration files."
        },
        "stacktape.hover": {
          "type": "boolean",
          "default": true,
          "description": "Enable/disable hover documentation for Stacktape configuration files."
        },
        "stacktape.completion": {
          "type": "boolean",
          "default": true,
          "description": "Enable/disable autocompletion for Stacktape configuration files."
        },
        "stacktape.validateReferences": {
          "type": "boolean",
          "default": true,
          "description": "Validate that $ResourceParam/$CfResourceParam/$Var directive arguments and connectTo entries reference a resource/variable defined in the file. Disable this if your resources or variables are split across multiple files."
        },
        "stacktape.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication between VS Code and the Stacktape language server."
        },
        "stacktape.defaultStage": {
          "type": "string",
          "default": "",
          "description": "Default stage prefilled when running Stacktape CLI commands (Deploy / Preview / Validate)."
        },
        "stacktape.defaultRegion": {
          "type": "string",
          "default": "",
          "description": "Default AWS region prefilled when running Stacktape CLI commands."
        },
        "stacktape.profile": {
          "type": "string",
          "default": "",
          "description": "AWS profile passed to Stacktape CLI commands (optional)."
        }
      }
    },
    "configurationDefaults": {
      "[stacktape]": {
        "editor.insertSpaces": true,
        "editor.tabSize": 2,
        "editor.quickSuggestions": {
          "other": true,
          "comments": false,
          "strings": true
        },
        "editor.autoIndent": "keep"
      }
    },
    "commands": [
      {
        "command": "stacktape.validate",
        "title": "Validate config",
        "category": "Stacktape",
        "icon": "$(check)"
      },
      {
        "command": "stacktape.preview",
        "title": "Preview changes (diff)",
        "category": "Stacktape",
        "icon": "$(git-compare)"
      },
      {
        "command": "stacktape.deploy",
        "title": "Deploy stack",
        "category": "Stacktape",
        "icon": "$(rocket)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "stacktape.validate",
          "when": "resourceFilename =~ /(stacktape|stp)(\\.debug|\\.config)?\\.(ya?ml|ts)$/"
        },
        {
          "command": "stacktape.preview",
          "when": "resourceFilename =~ /(stacktape|stp)(\\.debug|\\.config)?\\.(ya?ml|ts)$/"
        },
        {
          "command": "stacktape.deploy",
          "when": "resourceFilename =~ /(stacktape|stp)(\\.debug|\\.config)?\\.(ya?ml|ts)$/"
        }
      ],
      "editor/title": [
        {
          "command": "stacktape.preview",
          "when": "resourceFilename =~ /(stacktape|stp)(\\.debug|\\.config)?\\.(ya?ml|ts)$/",
          "group": "navigation@1"
        },
        {
          "command": "stacktape.deploy",
          "when": "resourceFilename =~ /(stacktape|stp)(\\.debug|\\.config)?\\.(ya?ml|ts)$/",
          "group": "navigation@2"
        }
      ],
      "editor/context": [
        {
          "command": "stacktape.validate",
          "when": "resourceFilename =~ /(stacktape|stp)(\\.debug|\\.config)?\\.(ya?ml|ts)$/",
          "group": "stacktape@1"
        },
        {
          "command": "stacktape.preview",
          "when": "resourceFilename =~ /(stacktape|stp)(\\.debug|\\.config)?\\.(ya?ml|ts)$/",
          "group": "stacktape@2"
        },
        {
          "command": "stacktape.deploy",
          "when": "resourceFilename =~ /(stacktape|stp)(\\.debug|\\.config)?\\.(ya?ml|ts)$/",
          "group": "stacktape@3"
        }
      ]
    }
  },
  "activationEvents": [
    "onLanguage:stacktape",
    "workspaceContains:**/*{stacktape,stp}*.{yml,yaml}"
  ],
  "icon": "static/stacktape-logo.png",
  "preview": false,
  "engines": {
    "vscode": "^1.82.0"
  },
  "packageManager": "pnpm@11.7.0"
}
